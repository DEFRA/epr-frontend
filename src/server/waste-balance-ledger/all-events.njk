{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block beforeContent %}
  {{ govukBackLink({ text: localise("common:back"), href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="app-page-body">

        <h1 class="govuk-heading-xl">
          <span class="govuk-caption-xl">{{ caption }}</span>
          {{ heading }}
        </h1>

        {% if rows | length > 0 %}
          <div style="overflow-x: auto" tabindex="0" role="region"
               aria-label="{{ localise('waste-balance-ledger:allEventsHeading') }}">
            {{ govukTable({
              head: [
                { text: localise("waste-balance-ledger:table.number") },
                { text: localise("waste-balance-ledger:table.event") },
                { text: localise("waste-balance-ledger:table.record") },
                { text: localise("waste-balance-ledger:table.recordTonnage"), format: "numeric" },
                { text: localise("waste-balance-ledger:table.availableChange"), format: "numeric" },
                { text: localise("waste-balance-ledger:table.availableTonnes"), format: "numeric" },
                { text: localise("waste-balance-ledger:table.balanceChange"), format: "numeric" },
                { text: localise("waste-balance-ledger:table.balanceTonnes"), format: "numeric" },
                { text: localise("waste-balance-ledger:table.date") },
                { text: localise("waste-balance-ledger:table.who") }
              ],
              rows: rows
            }) }}
          </div>
        {% else %}
          <p class="govuk-body" data-testid="no-events">{{ localise("waste-balance-ledger:noEvents") }}</p>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
