{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="app-page-body">

        <h1 class="govuk-heading-xl">
          <span class="govuk-caption-m govuk-!-margin-bottom-4">{{ caption }}</span>
          {{ heading }}
          {% if period %}
            <span class="govuk-!-display-block govuk-!-font-size-36">{{ period }}</span>
          {% endif %}
        </h1>

        {% set summaryListRows = [] %}
        {% for row in summaryRows %}
          {% if row.status %}
            {% set value = { html: govukTag({ text: row.status.text, classes: row.status.classes }) } %}
          {% elif row.html %}
            {% set value = { html: row.html } %}
          {% else %}
            {% set value = { text: row.value } %}
          {% endif %}
          {% set summaryListRows = summaryListRows.concat([{ key: { text: row.key }, value: value }]) %}
        {% endfor %}

        {{ govukSummaryList({ rows: summaryListRows }) }}

        {% set sectionHeading = localise("registrations:details:accreditation:reports:heading") %}
        {% set sectionHref = reports.href %}
        {% set sectionHasRows = reports.rows | length > 0 %}
        {% set sectionTestId = "reports" %}
        {% set sectionViewAllText = localise("registrations:details:accreditation:reports:viewAll") %}
        {% set sectionMostRecentText = localise("registrations:details:accreditation:reports:mostRecent", { count: reports.count }) %}
        {% include "partials/accreditation-section/header.njk" %}

        {% set reportsHead = reports.head %}
        {% set reportsRows = reports.rows %}
        {% set reportsNoneText = localise("registrations:details:accreditation:reports:none") %}
        {% include "partials/reports/table.njk" %}

        {% set sectionHeading = prns.heading %}
        {% set sectionHref = prns.href %}
        {% set sectionHasRows = prns.rows | length > 0 %}
        {% set sectionTestId = "prns" %}
        {% set sectionViewAllText = localise("registrations:details:accreditation:prns:viewAll") %}
        {% set sectionMostRecentText = localise("registrations:details:accreditation:prns:mostRecent", { count: prns.count }) %}
        {% include "partials/accreditation-section/header.njk" %}

        {% if prns.rows | length > 0 %}
          {{ govukTable({
            attributes: { "data-testid": "prns-table" },
            head: prns.head,
            rows: prns.rows
          }) }}
        {% else %}
          <p class="govuk-body app-colour-secondary" data-testid="no-prns-summary">{{ prns.noneText }}</p>
        {% endif %}

        {% if ledger %}
          {% set sectionHeading = localise("waste-balance-ledger:heading") %}
          {% set sectionHref = ledger.href %}
          {% set sectionHasRows = ledger.rows | length > 0 %}
          {% set sectionTestId = "ledger" %}
          {% set sectionViewAllText = localise("registrations:details:accreditation:ledger:viewAll") %}
          {% set sectionMostRecentText = localise("registrations:details:accreditation:ledger:mostRecent", { count: ledger.count }) %}
          {% include "partials/accreditation-section/header.njk" %}

          {% set ledgerRows = ledger.rows %}
          {% include "partials/waste-balance-ledger/table.njk" %}
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}
