{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="app-page-body">

        <h1 class="govuk-heading-xl">
          <span class="govuk-caption-m govuk-!-margin-bottom-4">{{ caption }}</span>
          {{ heading }}
          {% if period %}
            <span class="govuk-!-display-block govuk-!-font-size-36">{{ period }}</span>
          {% endif %}
        </h1>

        {% set summaryListRows = [] %}
        {% for row in summaryRows %}
          {% if row.status %}
            {% set value = { html: govukTag({ text: row.status.text, classes: row.status.classes }) } %}
          {% elif row.html %}
            {% set value = { html: row.html } %}
          {% else %}
            {% set value = { text: row.value } %}
          {% endif %}
          {% set summaryListRows = summaryListRows.concat([{ key: { text: row.key }, value: value }]) %}
        {% endfor %}

        {{ govukSummaryList({ rows: summaryListRows }) }}

        <h2 class="govuk-heading-m govuk-!-margin-top-9">{{ localise("registrations:details:accreditation:reports:heading") }}</h2>

        {% if reports.rows | length > 0 %}
          {{ govukTable({
            attributes: { "data-testid": "reports-table" },
            firstCellIsHeader: true,
            head: reports.head,
            rows: reports.rows
          }) }}
        {% else %}
          <p class="govuk-body app-colour-secondary" data-testid="no-reports">{{ localise("registrations:details:accreditation:reports:none") }}</p>
        {% endif %}

        {# No button where the full list would only repeat the empty state. #}
        <div class="govuk-!-margin-top-9 govuk-!-margin-bottom-6">
          <h2 class="govuk-heading-m govuk-!-display-inline-block govuk-!-margin-bottom-0">{{ prns.heading }}</h2>
          {% if prns.rows | length > 0 %}
            {{ govukButton({
              text: localise("registrations:details:accreditation:prns:viewAll"),
              href: prns.href,
              classes: "govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-3",
              attributes: { "data-testid": "prns-detailed-view-link" }
            }) }}
          {% endif %}
        </div>

        {% if prns.rows | length > 0 %}
          <h3 class="govuk-heading-s" data-testid="prns-most-recent">{{ localise("registrations:details:accreditation:prns:mostRecent", { count: prns.count }) }}</h3>
          {{ govukTable({
            attributes: { "data-testid": "prns-table" },
            head: prns.head,
            rows: prns.rows
          }) }}
        {% else %}
          <p class="govuk-body app-colour-secondary" data-testid="no-prns-summary">{{ prns.noneText }}</p>
        {% endif %}

        {% if ledger %}
          <h2 class="govuk-heading-m govuk-!-margin-top-9">{{ localise("waste-balance-ledger:heading") }}</h2>
          {% set ledgerRows = ledger.rows %}
          {% include "partials/waste-balance-ledger/table.njk" %}
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}
