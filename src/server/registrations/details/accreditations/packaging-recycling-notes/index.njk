{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{# `super()` keeps the layout's phase banner and breadcrumbs. #}
{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({ text: localise("common:back"), href: backUrl }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="govuk-body" data-testid="prns-detailed-view">

        <h1 class="govuk-heading-xl">
          <span class="govuk-caption-m govuk-!-margin-bottom-4">{{ caption }}</span>
          {{ heading }}
        </h1>

        {% include "partials/prns/note-tables.njk" %}

      </div>
    </div>
  </div>
{% endblock %}
