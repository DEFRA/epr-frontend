{# The tabs and four tables an accreditation's notes are drawn in, shared by
   the operator's list and the regulator's so a note reads the same to both.
   `cancelHint` is the operator's inset copy and is omitted for a regulator. #}
{% if hasCreatedPrns %}
  <div class="govuk-tabs" data-module="govuk-tabs">
    <h2 class="govuk-tabs__title">
      Contents
    </h2>
    <ul class="govuk-tabs__list">
      <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
        <a class="govuk-tabs__tab" href="#awaiting-action">
          {{ tabs.awaitingAction }}
        </a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#issued">
          {{ tabs.issued }}
        </a>
      </li>
      <li class="govuk-tabs__list-item">
        <a class="govuk-tabs__tab" href="#cancelled">
          {{ tabs.cancelled }}
        </a>
      </li>
    </ul>

    <div class="govuk-tabs__panel" id="awaiting-action">
      {% if cancelHint %}
        {{ govukInsetText({ text: cancelHint }) }}
      {% endif %}

      {% if table.rows | length > 0 %}
        <h2 class="govuk-heading-m">{{ awaitingAuthorisationHeading }}</h2>
        {{ govukTable({
          head: [
            { text: table.headings.recipient },
            { text: table.headings.createdAt },
            { text: table.headings.tonnage },
            { text: table.headings.status },
            { text: table.headings.action }
          ],
          rows: table.rows
        }) }}
      {% endif %}

      {% if cancellationTable.rows | length > 0 %}
        <h2 class="govuk-heading-m">{{ awaitingCancellationHeading }}</h2>
        {{ govukTable({
          head: [
            { text: cancellationTable.headings.recipient },
            { text: cancellationTable.headings.createdAt },
            { text: cancellationTable.headings.tonnage },
            { text: cancellationTable.headings.status },
            { text: cancellationTable.headings.action }
          ],
          rows: cancellationTable.rows
        }) }}
      {% endif %}

      {% if table.rows | length === 0 and cancellationTable.rows | length === 0 %}
        <p class="govuk-body">{{ noPrnsText }}</p>
      {% endif %}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="issued">
      {% if issuedTable.rows | length > 0 %}
        <h2 class="govuk-heading-m">{{ issuedHeading }}</h2>
        {{ govukTable({
          head: [
            { text: issuedTable.headings.prnNumber },
            { text: issuedTable.headings.recipient },
            { text: issuedTable.headings.dateIssued },
            { text: issuedTable.headings.tonnage },
            { text: issuedTable.headings.status },
            { text: issuedTable.headings.action }
          ],
          rows: issuedTable.rows
        }) }}
      {% else %}
        <p class="govuk-body">{{ noIssuedText }}</p>
      {% endif %}
    </div>

    <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="cancelled">
      {% if cancelledTable.rows | length > 0 %}
        <h2 class="govuk-heading-m">{{ cancelledHeading }}</h2>
        {{ govukTable({
          head: [
            { text: cancelledTable.headings.prnNumber },
            { text: cancelledTable.headings.recipient },
            { text: cancelledTable.headings.dateIssued },
            { text: cancelledTable.headings.tonnage },
            { text: cancelledTable.headings.status },
            { text: cancelledTable.headings.action }
          ],
          rows: cancelledTable.rows
        }) }}
      {% else %}
        <p class="govuk-body">{{ noCancelledText }}</p>
      {% endif %}
    </div>
  </div>
{% else %}
  <p class="govuk-body">{{ noPrnsCreatedText }}</p>
{% endif %}
