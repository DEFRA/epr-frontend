{% from "govuk/components/table/macro.njk" import govukTable %}

{% if ledgerRows | length > 0 %}
  {{ govukTable({
    attributes: { "data-testid": "waste-balance-ledger-table" },
    head: [
      { text: localise("waste-balance-ledger:table.date") },
      { text: localise("waste-balance-ledger:table.event") },
      { text: localise("waste-balance-ledger:table.tonnage") },
      { text: localise("waste-balance-ledger:table.balance") },
      { text: localise("waste-balance-ledger:table.available") },
      { text: localise("waste-balance-ledger:table.who") }
    ],
    rows: ledgerRows
  }) }}
{% else %}
  <p class="govuk-body" data-testid="no-events">{{ localise("waste-balance-ledger:noEvents") }}</p>
{% endif %}
