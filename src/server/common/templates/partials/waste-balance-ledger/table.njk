{% from "govuk/components/table/macro.njk" import govukTable %}

{#
  A ledger that holds no balance drops the balance column rather than filling
  it with a running zero, so its headings are built the way its rows are - the
  column is absent, not empty. `ledgerHoldsABalance` is unset for every caller
  but the registered-only period page, which is why the test is against false
  rather than for true.
#}
{% set ledgerBalanceHead = [] if ledgerHoldsABalance == false else [
  { text: localise("waste-balance-ledger:table.available"), format: "numeric" }
] %}

{% set ledgerHead = [
  { text: localise("waste-balance-ledger:table.date") },
  { text: localise("waste-balance-ledger:table.event") },
  { text: localise("waste-balance-ledger:table.tonnage"), format: "numeric" }
].concat(ledgerBalanceHead).concat([
  { text: localise("waste-balance-ledger:table.who") },
  {
    text: localise("waste-balance-ledger:table.actions"),
    classes: "govuk-!-text-align-right"
  }
]) %}

{% if ledgerRows | length > 0 %}
  {{ govukTable({
    attributes: { "data-testid": "waste-balance-ledger-table" },
    firstCellIsHeader: true,
    head: ledgerHead,
    rows: ledgerRows
  }) }}
{% else %}
  <p class="govuk-body app-colour-secondary" data-testid="no-events">{{ localise("waste-balance-ledger:noEvents") }}</p>
{% endif %}
