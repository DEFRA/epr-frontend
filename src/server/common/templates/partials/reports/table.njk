{% from "govuk/components/table/macro.njk" import govukTable %}

{% if reportsRows | length > 0 %}
  {{ govukTable({
    attributes: { "data-testid": "reports-table" },
    firstCellIsHeader: true,
    head: reportsHead,
    rows: reportsRows
  }) }}
{% else %}
  <p class="govuk-body app-colour-secondary" data-testid="no-reports">{{ reportsNoneText }}</p>
{% endif %}
