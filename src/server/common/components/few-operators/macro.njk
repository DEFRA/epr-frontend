{#
  A market insights value, and beneath it the operator counts where few
  operators contributed to it. The tag's words carry the mark, so it reads the
  same without its colour.
#}
{% macro withFewOperators(value, counts, tag) %}
  {{ value }}
  {% if counts %}
    <span class="govuk-!-display-block govuk-!-margin-top-1"><strong class="govuk-tag govuk-tag--yellow">{{ tag }}</strong></span>
    <span class="govuk-!-display-block govuk-body-s govuk-!-margin-bottom-0">{{ counts }}</span>
  {% endif %}
{% endmacro %}
