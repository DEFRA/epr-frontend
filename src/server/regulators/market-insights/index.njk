{% extends 'layouts/page.njk' %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      {{ govukInsetText({ text: localise('regulators:marketInsights:notice') }) }}
      <p class="govuk-body">{{ description }}</p>

      <ul class="govuk-list">
        {% for figureSet in figureSets %}
          <li>
            <a class="govuk-link govuk-link--no-visited-state" href="{{ figureSet.href }}">{{ figureSet.text }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endblock %}
