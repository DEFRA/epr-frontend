{% extends 'layouts/page.njk' %}

{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">
        <span class="govuk-caption-xl">{{ caption }}</span>
        {{ heading }}
      </h1>
      <p class="govuk-body">{{ description }}</p>
      <p class="govuk-body-s">{{ dataTakenAt }}</p>

      <h2 class="govuk-heading-m">{{ localise('regulators:marketInsights:calculation:heading') }}</h2>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:figure') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:submissions') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:monthCounted:leadIn') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ localise('regulators:marketInsights:calculation:monthCounted:received') }}</li>
        <li>{{ localise('regulators:marketInsights:calculation:monthCounted:product') }}</li>
        <li>{{ localise('regulators:marketInsights:calculation:monthCounted:exported') }}</li>
      </ul>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:countedIf:leadIn') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ localise('regulators:marketInsights:calculation:countedIf:fieldsComplete') }}</li>
        <li>{{ localise('regulators:marketInsights:calculation:countedIf:accreditationValid') }}</li>
      </ul>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:prnIssued') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:exportedNotCountedIf:leadIn') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ localise('regulators:marketInsights:calculation:exportedNotCountedIf:stoppedOrRefused') }}</li>
        <li>{{ localise('regulators:marketInsights:calculation:exportedNotCountedIf:siteNotApproved') }}</li>
        <li>{{ localise('regulators:marketInsights:calculation:exportedNotCountedIf:notValidOnExportDate') }}</li>
      </ul>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:product') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:accreditationStatus') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:sentOn') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:notesNotDeducted') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:live') }}</p>
      <p class="govuk-body">{{ localise('regulators:marketInsights:calculation:columns') }}</p>

      <div class="govuk-body" data-testid="app-page-body">
        {% set tableHead = [
          { text: localise('regulators:marketInsights:table:material') },
          { text: localise('regulators:marketInsights:table:accreditationType') }
        ] %}
        {% for month in wasteBalance.months %}
          {% set tableHead = tableHead.concat([{ text: month, format: "numeric" }]) %}
        {% endfor %}
        {% set tableHead = tableHead.concat([{ text: localise('regulators:marketInsights:table:total'), format: "numeric" }]) %}

        {% set tableRows = [] %}
        {% for row in wasteBalance.rows %}
          {% set cells = [{ text: row.material }, { text: row.accreditationType }] %}
          {% for netCredit in row.netCredits %}
            {% set cells = cells.concat([{ text: netCredit, format: "numeric" }]) %}
          {% endfor %}
          {% set cells = cells.concat([{ text: row.total, format: "numeric" }]) %}
          {% set tableRows = tableRows.concat([cells]) %}
        {% endfor %}

        {% set reportCells = [{ text: localise('regulators:marketInsights:table:reports'), colspan: 2 }] %}
        {% for count in wasteBalance.reports.byMonth %}
          {% set reportCells = reportCells.concat([{ text: count, format: "numeric" }]) %}
        {% endfor %}
        {% set reportCells = reportCells.concat([{ text: wasteBalance.reports.period, format: "numeric" }]) %}
        {% set tableRows = tableRows.concat([reportCells]) %}

        {{ govukTable({
          caption: localise('regulators:marketInsights:table:caption'),
          captionClasses: "govuk-table__caption--m",
          firstCellIsHeader: true,
          head: tableHead,
          rows: tableRows
        }) }}
      </div>
    </div>
  </div>
{% endblock %}
