{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl">{{ localise('regulators:organisations:heading') }}</h1>
      <p class="govuk-body">{{ localise('regulators:organisations:description') }}</p>

      <div class="epr-search-panel govuk-!-margin-bottom-8">
        <h2 class="govuk-heading-m">{{ localise('regulators:organisations:searchHeading') }}</h2>

        {# A search replaces the previous one rather than narrowing it, so the
           form carries no page and every search opens at the first page. #}
        <form method="get" action="">
          {{ govukInput({
            label: {
              text: localise('regulators:organisations:searchLabel'),
              classes: "govuk-label--s"
            },
            id: "search",
            name: "search",
            type: "search",
            value: search,
            autocomplete: "off",
            classes: "govuk-input--width-20"
          }) }}

          <div class="govuk-button-group">
            {{ govukButton({ text: localise('regulators:organisations:searchButton') }) }}

            {# Clearing is a link rather than a submit, so it drops the term by
               addressing the unsearched page instead of sending an empty one. #}
            {% if search %}
              {{ govukButton({
                text: localise('regulators:organisations:clearSearchButton'),
                href: clearSearchHref,
                classes: "govuk-button--secondary"
              }) }}
            {% endif %}
          </div>
        </form>
      </div>

      <h2 class="govuk-heading-m">{{ localise('regulators:organisations:browseHeading') }}</h2>

      <div class="govuk-body" data-testid="app-page-body">
        {% if organisations.length %}
          {% set tableRows = [] %}
          {% for organisation in organisations %}
            {# Every action link reads the same, so each one names the
               organisation it opens for a reader who hears the links alone. #}
            {% set row = [
              { text: organisation.name },
              { text: organisation.organisationId },
              { text: organisation.regulator },
              { html: govukTag({ text: organisation.status.text, classes: organisation.status.classes }) },
              { html: '<a class="govuk-link govuk-link--no-visited-state" href="' ~ (organisation.href | escape) ~ '">' ~ localise('regulators:organisations:table:view') ~ '<span class="govuk-visually-hidden"> ' ~ (organisation.name | escape) ~ '</span></a>' }
            ] %}
            {% set tableRows = tableRows.concat([row]) %}
          {% endfor %}

          {{ govukTable({
            firstCellIsHeader: true,
            head: [
              { text: localise('regulators:organisations:table:name') },
              { text: localise('regulators:organisations:table:organisationId') },
              { text: localise('regulators:organisations:table:regulator') },
              { text: localise('regulators:organisations:table:status') },
              { text: localise('regulators:organisations:table:actions') }
            ],
            rows: tableRows
          }) }}

          {% if pagination.previous or pagination.next %}
            {{ govukPagination(pagination) }}
          {% endif %}
        {% else %}
          {{ govukInsetText({ text: localise('regulators:organisations:noResults') }) }}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
