{% extends 'layouts/page.njk' %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block beforeContent %}
  {{ super() }}
  {{ govukBackLink({
    text: localise("common:back"),
    href: backUrl
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <span class="govuk-caption-xl">{{ caption }}</span>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body">{{ countLine }}</p>

      <p class="govuk-body">{{ editLead }} <a class="govuk-link" href="{{ uploadUrl }}">{{ chooseFileText }}</a> {{ editTrail }}</p>

      {% for worksheet in worksheets %}
        <h2 class="govuk-heading-m">{{ worksheet.name }}</h2>
        <ul class="govuk-list govuk-list--bullet">
          {% for row in worksheet.rows %}
            <li>{{ row }}</li>
          {% endfor %}
        </ul>
      {% endfor %}

      <p class="govuk-body">{{ helpLine | safe }}</p>

      <div class="govuk-button-group">
        {{ govukButton({
          text: returnToReportsText,
          href: returnToReportsUrl,
          classes: "govuk-button--secondary"
        }) }}

        {{ govukButton({
          text: uploadText,
          href: uploadUrl
        }) }}
      </div>

    </div>
  </div>
{% endblock %}
